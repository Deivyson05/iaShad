// use prisma-8

model Document {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  chunks    DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  chunkIndex Int

  document Document @relation(
    fields: [documentId],
    references: [id],
    onDelete: Cascade
  )

  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@index([documentId])
}